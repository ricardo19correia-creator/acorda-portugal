rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if true;

      match /completedGames/{gameId} {
        allow read, write: if true;
      }

      match /transactions/{txId} {
        allow read, write: if true;
      }

      match /match_rewards/{matchId} {
        allow read, write: if true;
      }
    }

    // Registo global de transações e comprovativos de pagamento
    match /transactions/{txId} {
      allow read, write: if true;
    }


    match /publicProfiles/{profileId} {
      allow read: if true;
      allow write: if true;
    }

    match /presence/{presenceId} {
      allow read, create, update, delete: if true;
    }

    // FILA DE MATCHMAKING 1V1 (Compatível com Google e Convidados)
    match /duelQueue/{ticketId} {
      allow read, create, update, delete: if true;
    }

    // SALAS E ARENAS DE DUELO (Compatível com Google e Convidados)
    match /duels/{duelId} {
      allow read, create, update, delete: if true;
    }
  }
}