rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Funções auxiliares de segurança
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
      );
    }

    // Coleção de Utilizadores (Perfis, moedas, inventário e estatísticas)
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.auth.uid == userId || request.resource.data.uid == request.auth.uid);
      allow update: if isAuthenticated() && (
        (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['vipEntitlements']))) ||
        isAdmin()
      );
      allow delete: if isOwner(userId) || isAdmin();

      // Subcoleção de Entitlements VIP Canónicos (Leitura exclusiva do dono; escrita restrita a Admin/Servidor)
      match /entitlements/{entitlementId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }

      match /completedGames/{gameId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /transactions/{txId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /match_rewards/{matchId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /walletTransactions/{txId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /aid_inventory/{aidId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /activeSession/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /xp_transactions/{txId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Histórico Anti-Repetição Global por Utilizador (Conta Oficial)
    match /userQuestionHistory/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow write: if isAuthenticated() && (isOwner(userId) || isAdmin());

      match /chunks/{chunkId} {
        allow read, write: if isAuthenticated() && (isOwner(userId) || isAdmin());
      }

      match /activeMatches/{matchId} {
        allow read, write: if isAuthenticated() && (isOwner(userId) || isAdmin());
      }
    }

    // Registo de transações globais (Append-only)
    match /transactions/{txId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Registo oficial de compras Google Play Billing (Escrita exclusiva do Servidor/Admin; Leitura apenas do comprador)
    match /googlePlayPurchases/{purchaseDocId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Perfis públicos para Rankings Nacionais e Disputa Distrital
    match /publicProfiles/{profileId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && (request.auth.uid == profileId || request.resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isOwner(profileId) || isAdmin();
    }

    // Presença pública em tempo real (100% Utilizadores Humanos Reais Autenticados)
    match /publicPresence/{userId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || request.resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Coleção legada desativada (Acesso exclusivo de administração para higienização)
    match /botPlayers/{botId} {
      allow read, write: if isAdmin();
    }

    // Fila de Matchmaking 1v1 (Acesso exclusivo a utilizadores autenticados)
    match /duelQueue/{ticketId} {
      allow read, write: if isAuthenticated();
    }

    // Salas e Arenas de Duelo 1v1 em tempo real (Acesso exclusivo a utilizadores autenticados)
    match /duels/{duelId} {
      allow read, write: if isAuthenticated();

      match /reactions/{reactionId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Salas de Jogo e Reações alternativas (compatibilidade retroativa)
    match /gameRooms/{roomId} {
      allow read, write: if isAuthenticated();

      match /reactions/{reactionId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Histórico de Jogos e Partidas Concluídas
    match /games/{gameId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (request.auth.uid == resource.data.userId || request.auth.uid == request.resource.data.userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Eventos Oficiais, Participantes e Rankings de Competição
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();

      // Participantes do Evento (Leitura pública para rankings; escrita restrita a Admin/Backend API)
      match /participants/{userId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Registo de partidas processadas para o evento
      match /matches/{matchId} {
        allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
        allow write: if isAdmin();
      }

      // Recompensas atribuídas do evento
      match /rewards_claimed/{userId} {
        allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
        allow write: if isAdmin();
      }
    }

    // Reportes de Perguntas e Suporte
    match /reports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Sistema Oficial de Feedback dos Utilizadores
    match /feedback/{feedbackId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && 
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.status == 'NEW' &&
                    request.resource.data.priority == 'MEDIUM';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Módulo Oficial «Os Criadores» (Página Social Comunitária)
    match /creatorPosts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() || request.resource.data.isAnonymous == true;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.authorId || isAdmin());

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow update, delete: if isAuthenticated() && (request.auth.uid == resource.data.authorId || isAdmin());
      }
    }

    match /creatorReports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Publicações da Comunidade (CriadoresFeed)
    match /publicacoes_comunidade/{postId} {
      allow read, create, update: if true;
      allow delete: if isAuthenticated() || isAdmin();
    }

    // ==========================================
    // 💬 COMUNIDADE OFICIAL ACORDA PORTUGAL
    // ==========================================
    match /community_posts/{postId} {
      // Leitura permitida para publicações publicadas, ou pelo próprio autor, ou por administradores
      allow read: if (resource.data.status == 'published') ||
                     (isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin()));

      // Criação permitida apenas para utilizadores autenticados com o seu próprio UID e valores iniciais limpos
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid && 
                       request.resource.data.status == 'published' &&
                       request.resource.data.likesCount == 0 &&
                       request.resource.data.commentsCount == 0;

      // Alteração:
      // 1. O próprio autor pode editar a mensagem/categoria ou atualizar status (e.g. 'removed'), mantendo o userId
      // 2. Outros utilizadores autenticados apenas podem alterar likesCount ou commentsCount (+1 / -1)
      // 3. Administradores podem moderar qualquer campo
      allow update: if (
        isAuthenticated() && (
          (
            resource.data.userId == request.auth.uid &&
            request.resource.data.userId == resource.data.userId
          ) ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount']) ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount']) ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount'])
          )
        )
      ) || isAdmin();

      // Eliminação permitida apenas ao autor da publicação ou a administradores
      allow delete: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();

      // Subcoleção de comentários
      match /comments/{commentId} {
        allow read: if (resource.data.status == 'published') ||
                       (isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin()));

        allow create: if isAuthenticated() && 
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.status == 'published';

        allow update: if (
          isAuthenticated() &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId
        ) || isAdmin();

        allow delete: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      }

      // Subcoleção de likes (um registo por utilizador autenticado)
      match /likes/{likeUserId} {
        allow read: if true;
        allow create, delete: if isAuthenticated() && request.auth.uid == likeUserId;
        allow update: if false;
      }
    }

    // Denúncias de publicações e comentários (acesso de leitura exclusivo a administradores)
    match /community_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // 👑 COLEÇÕES DO CENTRO DE CONTROLO MÁXIMO
    // ==========================================

    // Utilizadores Administradores
    match /adminUsers/{adminId} {
      allow read: if isAuthenticated() && (request.auth.uid == adminId || isAdmin());
      allow write: if isAdmin();
    }

    // Registo Imutável de Auditoria
    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false; // Append-only estrito
    }

    // Configurações Globais do Jogo
    match /adminSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Alertas do Sistema
    match /adminAlerts/{alertId} {
      allow read, write: if isAdmin();
    }

    // Métricas do Sistema
    match /systemMetrics/{metricId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}