rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Funções auxiliares de segurança
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
      );
    }

    // Coleção de Utilizadores (Perfis, moedas, inventário e estatísticas)
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.auth.uid == userId || request.resource.data.uid == request.auth.uid);
      allow update: if isAuthenticated() && (request.auth.uid == userId || request.resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isOwner(userId) || isAdmin();

      match /completedGames/{gameId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /transactions/{txId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /match_rewards/{matchId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /walletTransactions/{txId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Registo de transações globais (Append-only)
    match /transactions/{txId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Perfis públicos para Rankings Nacionais e Disputa Distrital
    match /publicProfiles/{profileId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && (request.auth.uid == profileId || request.resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isOwner(profileId) || isAdmin();
    }

    // Presença em tempo real (Conexões ativas)
    match /presence/{presenceId} {
      allow read, create, update, delete: if true;
    }

    // Fila de Matchmaking 1v1
    match /duelQueue/{ticketId} {
      allow read, create, update, delete: if true;
    }

    // Salas e Arenas de Duelo 1v1 em tempo real
    match /duels/{duelId} {
      allow read, create, update, delete: if true;
    }

    // Histórico de Jogos e Partidas Concluídas
    match /games/{gameId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Reportes de Perguntas e Suporte
    match /reports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Módulo Oficial «Os Criadores» (Página Social Comunitária)
    match /creatorPosts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() || request.resource.data.isAnonymous == true;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.authorId || isAdmin());

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow update, delete: if isAuthenticated() && (request.auth.uid == resource.data.authorId || isAdmin());
      }
    }

    match /creatorReports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Publicações da Comunidade (CriadoresFeed)
    match /publicacoes_comunidade/{postId} {
      allow read, create, update: if true;
      allow delete: if isAuthenticated() || isAdmin();
    }

    // Presença em Tempo Real de Humanos (Heartbeat Realtime)
    match /presence/{sessionId} {
      allow read, write: if true;
    }
    match /active_presence/{clientId} {
      allow read, write: if true;
    }

    // ==========================================
    // 👑 COLEÇÕES DO CENTRO DE CONTROLO MÁXIMO
    // ==========================================

    // Utilizadores Administradores
    match /adminUsers/{adminId} {
      allow read: if isAuthenticated() && (request.auth.uid == adminId || isAdmin());
      allow write: if isAdmin();
    }

    // Registo Imutável de Auditoria
    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false; // Append-only estrito
    }

    // Configurações Globais do Jogo
    match /adminSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Alertas do Sistema
    match /adminAlerts/{alertId} {
      allow read, write: if isAdmin();
    }

    // Métricas do Sistema
    match /systemMetrics/{metricId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}