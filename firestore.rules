rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Funções auxiliares de segurança
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Coleção de Utilizadores (Perfis, moedas, inventário e estatísticas)
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.auth.uid == userId || request.resource.data.uid == request.auth.uid);
      allow update: if isAuthenticated() && (request.auth.uid == userId || request.resource.data.uid == request.auth.uid);
      allow delete: if isOwner(userId);

      match /completedGames/{gameId} {
        allow read, write: if isOwner(userId);
      }

      match /transactions/{txId} {
        allow read, write: if isOwner(userId);
      }

      match /match_rewards/{matchId} {
        allow read, write: if isOwner(userId);
      }

      match /walletTransactions/{txId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Registo de transações globais (Append-only)
    match /transactions/{txId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Perfis públicos para Rankings Nacionais e Disputa Distrital
    match /publicProfiles/{profileId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && (request.auth.uid == profileId || request.resource.data.uid == request.auth.uid);
      allow delete: if isOwner(profileId);
    }

    // Presença em tempo real (Conexões ativas)
    match /presence/{presenceId} {
      allow read, create, update, delete: if true;
    }

    // Fila de Matchmaking 1v1
    match /duelQueue/{ticketId} {
      allow read, create, update, delete: if true;
    }

    // Salas e Arenas de Duelo 1v1 em tempo real
    match /duels/{duelId} {
      allow read, create, update, delete: if true;
    }

    // Histórico de Jogos e Partidas Concluídas
    match /games/{gameId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Reportes de Perguntas e Suporte
    match /reports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if true;
      allow update, delete: if false;
    }

    // Módulo Oficial «Os Criadores» (Página Social Comunitária)
    match /creatorPosts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() || request.resource.data.isAnonymous == true;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.authorId || request.auth.token.admin == true);

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow update, delete: if isAuthenticated() && (request.auth.uid == resource.data.authorId || request.auth.token.admin == true);
      }
    }

    match /creatorReports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if true;
      allow update, delete: if false;
    }

    // Publicações da Comunidade (CriadoresFeed)
    match /publicacoes_comunidade/{postId} {
      allow read, create, update: if true;
      allow delete: if isAuthenticated();
    }
  }
}